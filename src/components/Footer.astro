---
import { DISCLAIMER, SITE_NAME, nav } from '../data/site';

const footerNav = [
  ...nav,
  { label: 'Buy additional tokens', href: '/buy-additional-muse-tokens/' },
  { label: 'Manage subscription', href: '/cancel-manage-muse-subscription/' },
  { label: 'About', href: '/about/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Terms of Use', href: '/terms-of-use/' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__meta">
      <p class="site-footer__tagline">
        <strong>{SITE_NAME}</strong> provides independent information about Meta Muse.
      </p>
      <nav aria-label="Footer navigation">
        {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
    <p class="disclaimer">{DISCLAIMER}</p>
    <p class="disclaimer">Product information based on <a href="https://www.meta.com/help/subscriptions/1021145227643680/">Meta Help</a> and linked official sources. Last checked: <time datetime="2026-10-28">2026-10-28</time>. Benefits and availability may vary by region and account.</p>
  </div>
</footer>
