---
export interface RelatedLink {
  label: string;
  href: string;
  description?: string;
}

interface Props {
  links: RelatedLink[];
  title?: string;
}

const { links, title = 'Related reading' } = Astro.props;
---

<section class="related-links" aria-labelledby="related-heading">
  <h2 id="related-heading">{title}</h2>
  <ul class="related-links__grid">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>
            {link.label}
            {link.description && <span class="related-links__description">{link.description}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</section>
