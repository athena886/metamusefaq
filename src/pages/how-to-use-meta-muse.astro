const faqItems = [
  { question: 'Which business apps can Muse connect to?', answer: 'Meta lists Asana, Box, Canva, Dropbox, Figma, Granola, HighLevel, Intuit QuickBooks, Klaviyo, Lovable, Notion, Shopify, Slack, Stripe, and Zoom. Check Settings → Connectors for the options available to your account.' },
  { question: 'What are side chats in Muse?', answer: 'Side chats organize separate topics without cluttering the main chat. Muse stays aware across the main chat and side chats; they are not separate agents.' },
  { question: 'Where are Muse Artifacts saved?', answer: 'Completed Artifacts are saved to a workspace in the Library tab and shared in the thread. They can include PDFs, spreadsheets, documents, images, and podcasts.' },
